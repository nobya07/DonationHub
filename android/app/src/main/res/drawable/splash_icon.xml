<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash icon wrapper around the round app logo (splash_logo.png).

    The artwork already fills its full bitmap canvas, so it is drawn inside
    transparent insets (~25% each side). This guarantees that on Android 12+
    the system splash icon mask (a circle around the icon area) can never
    crop the outer ring of the logo: the artwork diameter (~50% of the icon
    envelope) always stays well inside the mask's safe zone. Shipping the
    bitmap at full resolution with a smaller rendered area also keeps the
    print-looking artwork crisp. No image file is modified.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:insetLeft="25%"
        android:insetTop="25%"
        android:insetRight="25%"
        android:insetBottom="25%"
        android:gravity="center">
        <bitmap
            android:src="@drawable/splash_logo"
            android:gravity="center" />
    </item>
</layer-list>